{
  "name": "ai-workbench-desktop",
  "version": "0.1.93",
  "description": "CodeHub AI desktop client",
  "author": "gaolin89898",
  "homepage": "https://github.com/gaolin89898/ai-workbench",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild:native": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "publish:linux": "electron-builder install-app-deps && electron-vite build && electron-builder --linux --publish always",
    "publish:win": "electron-builder install-app-deps && electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.203",
    "@file-viewer/preset-lite": "2.1.25",
    "@file-viewer/preset-office": "2.1.25",
    "@file-viewer/vue3": "2.1.25",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "12.11.1",
    "electron-updater": "^6.3.9",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "simple-git": "^3.27.0",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@file-viewer/vite-plugin": "2.1.25",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^42.5.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
